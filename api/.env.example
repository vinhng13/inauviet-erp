# Copy to .env for local development:  Copy-Item .env.example .env
NODE_ENV=development
PORT=3000

# Matches docker-compose.yml (db service). Port 5433 on the host avoids clashing with a local PostgreSQL.
DATABASE_URL=postgresql://erp:erp@localhost:5433/erp
# Separate database used by `npm run test:e2e` (created by docker/postgres/init.sql)
DATABASE_URL_TEST=postgresql://erp:erp@localhost:5433/erp_test

# Sign-in: username + password, session kept in an HttpOnly cookie.
# Days a session stays valid without use (each use extends it)
SESSION_DAYS=30
# Send the cookie over HTTPS only. Leave empty: on in production, off locally (http://localhost).
COOKIE_SECURE=

APP_TIMEZONE=Asia/Ho_Chi_Minh
# Comma-separated. Only needed when the web app is served from another origin.
CORS_ORIGINS=http://localhost:5173

# First administrator, used by `npm run db:seed` when no administrator has a password yet.
# Leave SEED_ADMIN_PASSWORD empty to generate one (printed once). It must be changed at first sign-in.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Quản trị viên
SEED_ADMIN_PASSWORD=
# Also create the sample customer and order DH example (true/false)
SEED_SAMPLE_DATA=true

# Shop details printed at the top of documents (quote, order, acceptance report, invoice…)
COMPANY_NAME=In Âu Việt
COMPANY_ADDRESS=[Địa chỉ cửa hàng]
COMPANY_PHONE=[Số điện thoại]
COMPANY_TAX_CODE=[Mã số thuế]

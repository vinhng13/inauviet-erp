{
  "name": "@erp/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "openapi": "nest build && node dist/openapi.js",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "postinstall": "prisma generate",
    "user:reset-admin": "tsx scripts/reset-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "16.6.1",
    "fflate": "0.8.2",
    "jose": "5.10.0",
    "nestjs-pino": "4.6.1",
    "pdfmake": "0.3.11",
    "pg": "8.23.1",
    "pino-http": "10.5.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pdfmake": "0.3.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}

# Production settings for docker-compose.prod.yml. Copy to .env.prod and fill in. Never commit .env.prod.

# Long random password for PostgreSQL (letters and digits only)
DB_PASSWORD=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token
TUNNEL_TOKEN=

# First administrator account, created by the seed step in DEPLOY.md (the password is printed once)
ADMIN_USERNAME=admin
ADMIN_NAME=Quản trị viên

# Days a sign-in stays valid without use
SESSION_DAYS=30

# Local port for checking the site on the server itself: http://localhost:8090
WEB_PORT=8090

# Shop details printed at the top of documents (quote, order, acceptance report, invoice…)
COMPANY_NAME=In Âu Việt
COMPANY_ADDRESS=[Địa chỉ cửa hàng]
COMPANY_PHONE=[Số điện thoại]
COMPANY_TAX_CODE=[Mã số thuế]
